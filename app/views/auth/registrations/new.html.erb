<div class="auth auth--signup">
  <div class="auth__content">
    <header class="auth__header">
      <%= link_to root_path do %>
        <%= localized_logo_image_tag class: "auth__header__logo", alt: "" %>
      <% end %>
      <%= link_to t(".home"), root_path, class: "auth__header__link" %>
    </header>
    <div class="auth__main">
      <div class=auth__heading>
        <h1 class="auth__title"><%= t(".title") %></h1>
        <p class="auth__desc"><%= t(".description") %></p>
      </div>
      <%= form_with model: @user, url: auth_registration_path, scope: :user, html: { class: "auth-form" } do |f| %>
        <% if @user.errors.any? %>
          <div class="auth-form__error" data-turbo-cache="false">
            <h2 class="auth-form__error__title"><%= t(".form.error") %></h2>
            <ul class="auth-form__error__list">
              <% @user.errors.full_messages.each do |message| %>
                <li class="auth-form__error__item"><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="auth-form__group">
          <%= f.label :email, t(".form.email.label"), class: "auth-form__label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "auth-form__input", placeholder: t(".form.email.placeholder") %>
        </div>
        <div class="auth-form__group">
          <%= f.label :password, t(".form.password.label"), class: "auth-form__label" %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "auth-form__input", placeholder: t(".form.password.placeholder") %>
        </div>
        <div class="auth-form__group">
          <%= f.label :password_confirmation, t(".form.password_confirmation.label"), class: "auth-form__label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "auth-form__input", placeholder: t(".form.password_confirmation.placeholder") %>
        </div>
        <div class="auth-form__group">
          <div class="auth-form__checkbox">
            <%= f.check_box :tos_agreement, class: "auth-form__checkbox-input" %>
            <%= f.label :tos_agreement, class: "auth-form__checkbox-label" do %>
              <%= t(
              ".form.terms",
              terms_link: link_to(t(".terms"), root_path, class: "auth__link"),
              privacy_link: link_to(t(".privacy"), root_path, class: "auth__link")
            ).html_safe %>
            <% end %>
          </div>
          <% if @user.errors[:tos_agreement].present? %>
            <span class="auth-form__error-message">
              <%= @user.errors[:tos_agreement].first %>
            </span>
          <% end %>
        </div>
        <%= f.submit t(".form.submit"), class: "auth-form__submit" %>
      <% end %>
      <p class="auth__text">
        <%= t(".already_registered") %> <%= link_to t(".sign_in"), auth_new_session_path, class: "auth__link" %>
      </p>
    </div>
  </div>
  <div class="auth__sidebar" style="background-image: url(<%= asset_path("sign-up.jpg") %>); background-size: 100% 100%; background-position: center; background-repeat: no-repeat;">
    <%= link_to t(".credits"), "https://www.freepik.com/free-vector/hand-drawn-crowd-people-walking-illustration_21559642.htm?epik=dj0yJnU9MTNQbzBTLTAxTTNyTmppcnZKYXJJckZObUVmNEhoVXEmcD0wJm49ZDZIMVNIMnhlbzFINlBCVnNmdHhMQSZ0PUFBQUFBR1NxU0ln", class: "auth__credits" %>
  </div>
</div>
