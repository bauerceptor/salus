<div class="auth auth--change-password">
  <div class="auth__content">
    <header class="auth__header">
      <%= link_to root_path do %>
        <%= localized_logo_image_tag class: "auth__header__logo", alt: "" %>
      <% end %>
      <%= link_to t(".home"), root_path, class: "auth__header__link" %>
    </header>
    <div class="auth__main">
      <div class=auth__heading>
        <h1 class="auth__title"><%= t(".title") %></h1>
        <p class="auth__desc"><%= t(".description") %></p>
      </div>
      <%= form_with url: auth_update_password_path, scope: :user, method: :put, html: { class: "auth-form" } do |f| %>
        <%= f.hidden_field :reset_password_token, value: params[:token] %>
        <div class="auth-form__group">
          <%= f.label :password, t(".form.password.label"), class: "auth-form__label" %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "auth-form__input", placeholder: t(".form.password.placeholder") %>
        </div>
        <div class="auth-form__group">
          <%= f.label :password_confirmation, t(".form.password_confirmation.label"), class: "auth-form__label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "auth-form__input", placeholder: t(".form.password_confirmation.placeholder") %>
        </div>
        <%= f.submit t(".form.submit"), class: "auth-form__submit" %>
      <% end %>
      <p class="auth__text">
        <%= t(".reminded") %> <%= link_to t(".sign_in"), auth_new_session_path, class: "auth__link" %>
      </p>
    </div>
  </div>
  <div class="auth__sidebar" style="background-image: url(<%= asset_path("reset-password.jpg") %>); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <%= link_to t(".credits"), "https://www.freepik.com/free-vector/home-interior-background-concept_9694077.htm#page=2&position=44&from_view=author", class: "auth__credits" %>
  </div>
</div>
