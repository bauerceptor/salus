<div class="auth auth--reset">
  <div class="auth__content">
    <header class="auth__header">
      <%= link_to root_path do %>
        <%= localized_logo_image_tag class: "auth__header__logo", alt: "" %>
      <% end %>
      <%= link_to t(".home"), root_path, class: "auth__header__link" %>
    </header>
    <div class="auth__main">
      <div class=auth__heading>
        <h1 class="auth__title"><%= t(".title") %></h1>
        <p class="auth__desc"><%= t(".description") %></p>
      </div>
      <%= form_with url: auth_password_path, scope: :email, html: { method: :post, class: "auth-form" } do |f| %>
        <div class="auth-form__group">
          <%= f.label :email, t(".form.email.label"), class: "auth-form__label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "auth-form__input", placeholder: t(".form.email.placeholder") %>
        </div>
        <%= f.submit t(".form.submit"), class: "auth-form__submit" %>
      <% end %>
      <p class="auth__text">
        <%= t(".remember_password") %> <%= link_to t(".sign_in"), auth_new_session_path, class: "auth__link" %>
      </p>
    </div>
  </div>
  <div class="auth__sidebar" style="background-image: url(<%= asset_path("reset-password.jpg") %>); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <%= link_to t(".credits"), "https://www.freepik.com/free-vector/flat-couple-with-cute-dog-home_15614429.htm#from_view=detail_alsolike", class: "auth__credits" %>
  </div>
</div>
