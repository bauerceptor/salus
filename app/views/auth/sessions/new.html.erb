<div class="auth auth--login">
  <div class="auth__content">
    <header class="auth__header">
      <%= link_to root_path do %>
        <%= localized_logo_image_tag class: "auth__header__logo", alt: "" %>
      <% end %>
      <%= link_to t(".home"), root_path, class: "auth__header__link" %>
    </header>
    <div class="auth__main">
      <div class=auth__heading>
        <h1 class="auth__title"><%= t(".title") %></h1>
        <p class="auth__desc"><%= t(".description") %></p>
      </div>
      <%= form_with url: auth_session_path, scope: :session, html: { class: "auth-form" } do |f| %>
        <% if alert %>
          <div class="auth-form__flash auth-form__alert">
            <%= alert %>
          </div>
        <% end %>
        <div class="auth-form__group">
          <%= f.label :email, t(".form.email.label"), class: "auth-form__label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "auth-form__input", placeholder: t(".form.email.placeholder") %>
        </div>
        <div class="auth-form__group">
          <%= f.label :password, t(".form.password.label"), class: "auth-form__label" %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "auth-form__input", placeholder: t(".form.password.placeholder") %>
        </div>
        <%= f.submit t(".form.submit"), class: "auth-form__submit" %>
      <% end %>
      <p class="auth__text">
        <%= t(".forgot_password") %> <%= link_to t(".reset_password"), auth_new_password_path, class: "auth__link" %>
      </p>
      <p class="auth__text">
        <%= t(".not_registered") %> <%= link_to t(".sign_up"), auth_new_registration_path, class: "auth__link" %>
      </p>
      <div class="auth__portal-links">
        <p class="auth__portal-links__text">Other Portals:</p>
        <div class="auth__portal-buttons">
          <%= link_to "/specialist/sign_in", class: "auth__portal-btn auth__portal-btn--doctor" do %>
            <i class="ri-stethoscope-line"></i>
            Doctor Login
          <% end %>
          <%= link_to "/admin/sign_in", class: "auth__portal-btn auth__portal-btn--admin" do %>
            <i class="ri-admin-line"></i>
            Admin Login
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="auth__sidebar" style="background-image: url(<%= asset_path("login-patient.jpg") %>); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <%= link_to t(".credits"), "https://www.freepik.com/free-vector/flat-design-people-with-disability-room_10627406.htm#page=11&position=15&from_view=author", class: "auth__credits" %>
  </div>
</div>
