  font-size: 12px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 10px;
  flex-shrink: 0;
}

.wa-chat {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #efeae2;
}

.wa-chat__placeholder {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f0f2f5;
  color: #667781;
}

.wa-chat__placeholder-icon {
  font-size: 80px;
  margin-bottom: 16px;
  opacity: 0.3;
}

.wa-chat__placeholder p {
  font-size: 16px;
}
</style>