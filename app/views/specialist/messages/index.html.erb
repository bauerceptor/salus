<div class="wa-app">

  <!-- Left: Conversation List (40%) -->
  <aside class="wa-conversations">
    <div class="wa-conversations__header">
      <h1 class="wa-conversations__title">Chats</h1>
    </div>
    <div class="wa-conversations__list">
      <% if @conversations.any? %>
        <% @conversations.each do |msg| %>
          <% last_message = current_user.specialist_messages.where(account_id: msg.account_id).order(created_at: :desc).first %>
          <% unread_count = current_user.specialist_messages.where(account_id: msg.account_id, is_read: false, sender_type: 'patient').count %>
          <%= link_to specialist_message_path(id: last_message.id, locale: I18n.locale), class: "wa-conversation-item" do %>
            <div class="wa-conversation-item__avatar">
              <i class="ri-user-3-line"></i>
            </div>
            <div class="wa-conversation-item__content">
              <div class="wa-conversation-item__row">
                <span class="wa-conversation-item__name"><%= msg.account.full_name %></span>
                <span class="wa-conversation-item__time"><%= last_message.created_at.strftime("%H:%M") %></span>
              </div>
              <div class="wa-conversation-item__row">
                <span class="wa-conversation-item__preview">
                  <% if last_message.reply_from_patient? %>
                    <i class="ri-check-line"></i>
                  <% end %>
                  <%= last_message.subject %>
                </span>
                <% if unread_count > 0 %>
                  <span class="wa-conversation-item__badge"><%= unread_count %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="wa-conversations__empty">
          <i class="ri-user-search-line"></i>
          <p>No conversations yet</p>
          <span>Connect with patients to start chatting</span>
          <%= link_to specialist_patients_path, class: "wa-conversations__find-btn" do %>
            <i class="ri-user-add-line"></i>
            Find Patients
          <% end %>
        </div>
      <% end %>
    </div>
  </aside>

  <!-- Right: Placeholder -->
  <main class="wa-chat">
    <div class="wa-chat__placeholder">
      <div class="wa-chat__placeholder-icon">
        <i class="ri-chat-smile-3-line"></i>
      </div>
      <p>Select a conversation</p>
    </div>
  </main>
</div>

<style>
.wa-app {
  display: flex;
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.wa-conversations {
  width: 30%;
  min-width: 280px;
  max-width: 380px;
  border-right: 1px solid #e0e0e0;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.wa-conversations__header {
  padding: 15px 16px;
  border-bottom: 1px solid #e0e0e0;
}

.wa-conversations__title {
  font-size: 20px;
  font-weight: 600;
  color: #111;
  margin: 0;
}

.wa-conversations__list {
  flex: 1;
  overflow-y: auto;
}

.wa-conversations__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200px;
  color: #667781;
  text-align: center;
  padding: 20px;
}

.wa-conversations__empty i {
  font-size: 48px;
  margin-bottom: 12px;
  color: #d1d5db;
}

.wa-conversations__empty p {
  font-size: 16px;
  font-weight: 500;
  color: #5f6368;
  margin: 0 0 4px 0;
}

.wa-conversations__empty span {
  font-size: 14px;
  color: #9aa0a6;
  margin-bottom: 16px;
}

.wa-conversations__find-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 20px;
  background: var(--color-primary);
  color: white;
  border-radius: 24px;
  font-size: 14px;
  font-weight: 500;
