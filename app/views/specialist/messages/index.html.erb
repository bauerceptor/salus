  transition: background 0.2s ease, transform 0.15s ease;
}

.wa-conversations__find-btn i {
  font-size: 18px;
  margin: 0;
  color: white;
}

.wa-conversations__find-btn:hover {
  background: var(--color-primary-dark);
  transform: translateY(-1px);
}

.wa-conversation-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s;
}

.wa-conversation-item:hover {
  background: #f5f5f5;
}

.wa-conversation-item__avatar {
  width: 50px;
  height: 50px;
  background: #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 24px;
  flex-shrink: 0;
}

.wa-conversation-item__content {
  flex: 1;
  min-width: 0;
}

.wa-conversation-item__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.wa-conversation-item__name {
  font-size: 16px;
  font-weight: 500;
  color: #111;
}

.wa-conversation-item__time {
  font-size: 12px;
  color: #667781;
  flex-shrink: 0;
}

.wa-conversation-item__preview {
  font-size: 14px;
  color: #667781;
