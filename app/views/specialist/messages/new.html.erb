<div class="page-form">
  <header class="dash-header">
    <div class="dash-header__left">
      <h1 class="dash-header__title">
        <i class="ri-edit-line dash-header__title__icon"></i>
        <%= t(".title") %>
      </h1>
      <%= render "shared/breadcrumbs" %>
    </div>
    <div class="dash-header__right">
      <%= link_to specialist_messages_path, class: "dash-button dash-button--back" do %>
        <i class="ri-arrow-left-line dash-button__icon"></i>
      <% end %>
    </div>
  </header>

  <div class="dash-flash-messages">
    <%= turbo_frame_tag "flash" do %>
      <%= render "shared/dash_flash" %>
    <% end %>
  </div>

  <div class="dash-group">
    <div class="dash-group__content">
      <%= form_with model: @message, url: specialist_messages_path, method: :post, class: "form" do |f| %>
        <div class="form__group">
          <%= f.label :account_id, t(".form.recipient.label"), class: "form__label" %>
          <%= f.select :account_id,
              options_from_collection_for_select(
                current_user.specialist_patients.active.includes(:account).map(&:account),
                :id, :full_name, @recipient_id
              ),
              { prompt: t(".form.recipient.placeholder") },
              class: "form__select" %>
        </div>

        <div class="form__group">
          <%= f.label :subject, t(".form.subject.label"), class: "form__label" %>
          <%= f.text_field :subject, class: "form__input", placeholder: t(".form.subject.placeholder") %>
        </div>

        <div class="form__group">
          <%= f.label :body, t(".form.body.label"), class: "form__label" %>
          <%= f.text_area :body, class: "form__textarea", rows: 6, placeholder: t(".form.body.placeholder") %>
        </div>

        <div class="form__info">
          <i class="ri-information-line"></i>
          <p><%= t(".info") %></p>
        </div>

        <div class="form__actions">
          <%= f.submit t(".form.submit"), class: "dash-button dash-button--blue" %>
          <%= link_to t(".form.cancel"), specialist_messages_path, class: "dash-button dash-button--gray" %>
        </div>
      <% end %>
    </div>
  </div>
</div>