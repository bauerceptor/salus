                  <div class="resolve-modal__content">
                    <div class="modal-box">
                      <h3 class="font-bold text-lg"><%= t(".resolve_alert") %></h3>
                      <%= form_with url: specialist_notification_acknowledgment_path(notification_id: alert.id) do |f| %>
                        <div class="form-group">
