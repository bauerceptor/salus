<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Escape Room Challenge</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      min-height: 100vh;
      color: #fff;
      overflow-x: hidden;
    }

    .game-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    .game-header {
      text-align: center;
      padding: 30px 0;
    }

    .game-header h1 {
      font-size: 2.5rem;
      background: linear-gradient(90deg, #e94560, #f39c12);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 10px;
    }

    .game-stats {
      display: flex;
      justify-content: center;
      gap: 40px;
      margin: 20px 0;
    }

    .stat {
      background: rgba(255,255,255,0.1);
      padding: 15px 30px;
      border-radius: 10px;
      backdrop-filter: blur(10px);
    }

    .stat-label { font-size: 0.9rem; opacity: 0.7; }
    .stat-value { font-size: 1.8rem; font-weight: bold; color: #e94560; }

    .room-scene {
      position: relative;
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      aspect-ratio: 16/10;
      background: linear-gradient(180deg, #2c3e50 0%, #1a252f 100%);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }

    .room-svg {
      width: 100%;
      height: 100%;
    }

    .puzzle-door {
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .puzzle-door:hover {
      filter: brightness(1.3);
      transform: scale(1.02);
    }

    .puzzle-door.unlocked {
      filter: hue-rotate(80deg) brightness(1.2);
    }

    .puzzle-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.9);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }

    .puzzle-modal.active { display: flex; }

    .puzzle-content {
      background: linear-gradient(135deg, #1a1a2e, #16213e);
      padding: 40px;
      border-radius: 20px;
      max-width: 600px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
    }

    .puzzle-close {
      position: absolute;
      top: 15px;
      right: 20px;
      background: none;
      border: none;
      color: #fff;
      font-size: 1.5rem;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.3s;
    }

    .puzzle-close:hover { opacity: 1; }

    .puzzle-title {
      font-size: 1.8rem;
      margin-bottom: 20px;
      color: #e94560;
    }

    .puzzle-description {
      margin-bottom: 25px;
      line-height: 1.6;
      opacity: 0.9;
    }

    .puzzle-grid {
      display: grid;
      gap: 10px;
      margin-bottom: 20px;
    }

    .puzzle-input {
      width: 100%;
      padding: 15px;
      font-size: 1.1rem;
      border: 2px solid rgba(255,255,255,0.2);
      border-radius: 10px;
      background: rgba(255,255,255,0.05);
      color: #fff;
      outline: none;
      transition: border-color 0.3s;
    }

    .puzzle-input:focus { border-color: #e94560; }

    .puzzle-btn {
      width: 100%;
      padding: 15px;
      font-size: 1.1rem;
      background: linear-gradient(135deg, #e94560, #f39c12);
      border: none;
      border-radius: 10px;
      color: #fff;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .puzzle-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(233,69,96,0.3);
    }

    .feedback {
      margin-top: 15px;
      padding: 15px;
      border-radius: 10px;
      text-align: center;
      display: none;
    }

    .feedback.success { background: rgba(39,174,96,0.3); display: block; }
    .feedback.error { background: rgba(231,76,60,0.3); display: block; }

    .progress-bar {
      width: 100%;
      height: 10px;
      background: rgba(255,255,255,0.1);
      border-radius: 5px;
      margin-top: 30px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #e94560, #f39c12);
      width: 0%;
      transition: width 0.5s ease;
      border-radius: 5px;
    }

    .puzzle-hint {
      margin-top: 15px;
      padding: 12px;
      background: rgba(243,156,18,0.2);
      border-left: 3px solid #f39c12;
      font-size: 0.9rem;
      opacity: 0.8;
    }

    .math-puzzle .equation {
      font-size: 2rem;
      text-align: center;
      padding: 30px;
      background: rgba(255,255,255,0.05);
      border-radius: 10px;
      margin-bottom: 20px;
    }

    .flexbox-puzzle {
      display: flex;
      gap: 10px;
      padding: 20px;
      background: rgba(255,255,255,0.05);
      border-radius: 10px;
      min-height: 150px;
      align-items: center;
      justify-content: center;
    }

    .flexbox-item {
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #e94560, #f39c12);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    .mirror-puzzle canvas {
      border: 2px solid rgba(255,255,255,0.2);
      border-radius: 10px;
      margin: 0 auto;
      display: block;
    }

    .pipe-puzzle .pipe-grid {
      display: grid;
      grid-template-columns: repeat(6, 50px);
      gap: 2px;
      justify-content: center;
    }

    .pipe-cell {
      width: 50px;
      height: 50px;
      background: rgba(255,255,255,0.1);
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .pipe-cell:hover { background: rgba(255,255,255,0.2); }
    .pipe-cell.filled { background: rgba(39,174,96,0.5); }

    .recursion-puzzle {
      text-align: center;
    }

    .recursion-step {
      padding: 10px 20px;
      margin: 5px;
      background: rgba(255,255,255,0.1);
      border-radius: 5px;
      display: inline-block;
    }

    .victory-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.95);
      z-index: 2000;
      justify-content: center;
      align-items: center;
      flex-direction: column;
    }

    .victory-overlay.active { display: flex; }

    .victory-content {
      text-align: center;
    }

    .victory-content h2 {
      font-size: 3rem;
      background: linear-gradient(90deg, #e94560, #f39c12);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 20px;
    }

    .victory-stats {
      display: flex;
      gap: 30px;
      justify-content: center;
      margin: 30px 0;
    }

    .victory-stat {
      background: rgba(255,255,255,0.1);
      padding: 20px 40px;
      border-radius: 15px;
    }

    .play-again-btn {
      padding: 20px 50px;
      font-size: 1.3rem;
      background: linear-gradient(135deg, #e94560, #f39c12);
      border: none;
      border-radius: 50px;
      color: #fff;
      cursor: pointer;
      margin-top: 30px;
      transition: transform 0.3s;
    }

    .play-again-btn:hover { transform: scale(1.1); }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .floating { animation: float 3s ease-in-out infinite; }
  </style>
</head>
<body>
  <div class="game-container">
    <div class="game-header">
      <h1><i class="fas fa-door-open"></i> Escape Room Challenge</h1>
      <p>Unlock all 6 puzzles to escape!</p>
    </div>

    <div class="game-stats">
      <div class="stat">
        <div class="stat-label">Puzzles Solved</div>
        <div class="stat-value" id="puzzlesSolved">0 / 6</div>
      </div>
      <div class="stat">
        <div class="stat-label">Time Elapsed</div>
        <div class="stat-value" id="timer">00:00</div>
      </div>
    </div>

    <div class="room-scene">
      <svg class="room-svg" viewBox="0 0 900 562" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="wallGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#3d5a80"/>
            <stop offset="100%" style="stop-color:#293241"/>
          </linearGradient>
          <linearGradient id="floorGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#4a5568"/>
            <stop offset="100%" style="stop-color:#2d3748"/>
          </linearGradient>
        </defs>

        <rect width="900" height="400" fill="url(#wallGrad)"/>
        <rect y="400" width="900" height="162" fill="url(#floorGrad)"/>

        <line x1="0" y1="400" x2="900" y2="400" stroke="#1a202c" stroke-width="4"/>

        <rect x="60" y="120" width="120" height="200" fill="#1a202c" rx="5"/>
        <rect x="70" y="130" width="100" height="80" fill="#2d3748"/>
        <rect x="70" y="220" width="100" height="90" fill="#2d3748"/>
        <circle cx="150" cy="230" r="5" fill="#f39c12"/>

        <rect x="720" y="120" width="120" height="200" fill="#1a202c" rx="5"/>
        <rect x="730" y="130" width="100" height="80" fill="#2d3748"/>
        <rect x="730" y="220" width="100" height="90" fill="#2d3748"/>
        <circle cx="810" cy="230" r="5" fill="#f39c12"/>

        <rect x="350" y="50" width="200" height="120" fill="#2d3748" rx="10"/>
        <rect x="360" y="60" width="180" height="70" fill="#1a202c"/>
        <text x="450" y="100" text-anchor="middle" fill="#e94560" font-size="24" font-weight="bold">ESCAPE</text>
        <text x="450" y="130" text-anchor="middle" fill="#fff" font-size="12">ROOM</text>

        <g class="puzzle-door" id="door1" data-puzzle="puzzler" transform="translate(100, 220)">
          <rect width="80" height="140" fill="#8b4513" rx="5"/>
          <rect x="5" y="5" width="70" height="130" fill="#a0522d" rx="3"/>
          <circle cx="65" cy="75" r="8" fill="#f39c12"/>
          <text x="40" y="160" text-anchor="middle" fill="#fff" font-size="11">Puzzler</text>
        </g>

        <g class="puzzle-door" id="door2" data-puzzle="math" transform="translate(220, 220)">
          <rect width="80" height="140" fill="#2c5282" rx="5"/>
          <rect x="5" y="5" width="70" height="130" fill="#3182ce" rx="3"/>
          <text x="40" y="80" text-anchor="middle" fill="#fff" font-size="30">∑</text>
          <text x="40" y="160" text-anchor="middle" fill="#fff" font-size="11">Math</text>
        </g>

        <g class="puzzle-door" id="door3" data-puzzle="flexbox" transform="translate(340, 220)">
          <rect width="80" height="140" fill="#276749" rx="5"/>
          <rect x="5" y="5" width="70" height="130" fill="#38a169" rx="3"/>
          <rect x="15" y="60" width="20" height="20" fill="#fff"/>
          <rect x="40" y="60" width="20" height="20" fill="#fff"/>
          <rect x="25" y="85" width="20" height="20" fill="#fff"/>
          <text x="40" y="160" text-anchor="middle" fill="#fff" font-size="11">Flexbox</text>
        </g>

        <g class="puzzle-door" id="door4" data-puzzle="mirror" transform="translate(480, 220)">
          <rect width="80" height="140" fill="#702459" rx="5"/>
          <rect x="5" y="5" width="70" height="130" fill="#9b2c6c" rx="3"/>
          <rect x="20" y="40" width="40" height="60" fill="#e2e8f0" rx="3"/>
          <line x1="20" y1="40" x2="60" y2="100" stroke="#702459" stroke-width="2"/>
          <line x1="60" y1="40" x2="20" y2="100" stroke="#702459" stroke-width="2"/>
          <text x="40" y="160" text-anchor="middle" fill="#fff" font-size="11">Mirror</text>
        </g>

        <g class="puzzle-door" id="door5" data-puzzle="pipe" transform="translate(600, 220)">
          <rect width="80" height="140" fill="#744210" rx="5"/>
          <rect x="5" y="5" width="70" height="130" fill="#975a16" rx="3"/>
          <path d="M25 40 L55 40 L55 70" stroke="#fff" stroke-width="6" fill="none"/>
          <circle cx="55" cy="70" r="8" fill="#38a169"/>
          <text x="40" y="160" text-anchor="middle" fill="#fff" font-size="11">Pipe</text>
        </g>

        <g class="puzzle-door" id="door6" data-puzzle="recursion" transform="translate(720, 220)">
          <rect width="80" height="140" fill="#553c9a" rx="5"/>
          <rect x="5" y="5" width="70" height="130" fill="#805ad5" rx="3"/>
          <text x="40" y="70" text-anchor="middle" fill="#fff" font-size="14">function</text>
          <text x="40" y="90" text-anchor="middle" fill="#fff" font-size="10">escape()</span></text>
          <text x="40" y="160" text-anchor="middle" fill="#fff" font-size="11">Recursion</text>
        </g>

        <g class="floating" transform="translate(400, 420)">
          <ellipse cx="50" cy="80" rx="40" ry="10" fill="rgba(0,0,0,0.3)"/>
          <rect x="20" y="20" width="60" height="60" fill="#e94560" rx="10"/>
          <rect x="30" y="30" width="40" height="25" fill="#1a1a2e"/>
          <circle cx="40" cy="42" r="5" fill="#4fd1c5"/>
          <circle cx="60" cy="42" r="5" fill="#4fd1c5"/>
          <rect x="35" y="55" width="30" height="20" fill="#1a1a2e" rx="3"/>
          <rect x="70" y="40" width="25" height="8" fill="#e94560" rx="2"/>
        </g>
      </svg>
    </div>

    <div class="progress-bar">
      <div class="progress-fill" id="progressFill"></div>
    </div>
  </div>

  <div class="puzzle-modal" id="puzzleModal">
    <div class="puzzle-content">
      <button class="puzzle-close" onclick="closePuzzle()">&times;</button>
      <div id="puzzleContent"></div>
    </div>
  </div>

  <div class="victory-overlay" id="victoryOverlay">
    <div class="victory-content">
      <h2><i class="fas fa-trophy"></i> You Escaped!</h2>
      <p>Congratulations! You solved all 6 puzzles!</p>
      <div class="victory-stats">
        <div class="victory-stat">
          <div class="stat-label">Total Time</div>
          <div class="stat-value" id="finalTime">00:00</div>
        </div>
        <div class="victory-stat">
          <div class="stat-label">Puzzles Solved</div>
          <div class="stat-value">6 / 6</div>
        </div>
      </div>
      <button class="play-again-btn" onclick="resetGame()"><i class="fas fa-redo"></i> Play Again</button>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/underscore.js/1.13.6/underscore-min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.js"></script>

  <script>
    const gameState = {
      solved: new Set(),
      startTime: Date.now(),
      timerInterval: null
    };

    const puzzleData = {
      puzzler: {
        title: "Puzzler Challenge",
        description: "Arrange the numbered tiles in order from 1-8 by sliding them into the empty space. Click a tile adjacent to the empty space to slide it.",
        type: "sliding"
      },
      math: {
        title: "Math Challenge",
        description: "Solve the equation. What is the value of x? (x × 7) + 15 = 100",
        answer: "12",
        type: "input"
      },
      flexbox: {
        title: "Flexbox Challenge",
        description: "Arrange the boxes so they are centered both horizontally and vertically. Use justify-content and align-items.",
        answer: "center center",
        type: "flexbox"
      },
      mirror: {
        title: "Mirror Challenge",
        description: "Draw the reflected image of the pattern. Your drawing will be mirrored automatically.",
        type: "canvas"
      },
      pipe: {
        title: "Pipe Challenge",
        description: "Connect the pipes from START to END. Click pipes to rotate them. Create an unbroken path.",
        answer: "connected",
        type: "pipe"
      },
      recursion: {
        title: "Recursion Challenge",
        description: "What is the output of this recursive function when called with n=5? Count the steps: f(n) = f(n-1) + n, f(0) = 0",
        answer: "15",
        type: "input"
      }
    };

    $(document).ready(function() {
      startTimer();

      $('.puzzle-door').on('click', function() {
        const puzzle = $(this).data('puzzle');
        openPuzzle(puzzle);
      });
    });

    function startTimer() {
      gameState.timerInterval = setInterval(function() {
        const elapsed = Math.floor((Date.now() - gameState.startTime) / 1000);
        const minutes = String(Math.floor(elapsed / 60)).padStart(2, '0');
        const seconds = String(elapsed % 60).padStart(2, '0');
        $('#timer').text(`${minutes}:${seconds}`);
      }, 1000);
    }

    function openPuzzle(puzzleId) {
      const puzzle = puzzleData[puzzleId];
      let content = `
        <h2 class="puzzle-title">${puzzle.title}</h2>
        <p class="puzzle-description">${puzzle.description}</p>
      `;

      if (puzzle.type === 'input') {
        content += `
          <input type="text" class="puzzle-input" id="puzzleAnswer" placeholder="Enter your answer...">
          <button class="puzzle-btn" onclick="checkAnswer('${puzzleId}')">Submit</button>
          <div class="feedback" id="feedback"></div>
          <div class="puzzle-hint"><i class="fas fa-lightbulb"></i> Think carefully about the logic</div>
        `;
      } else if (puzzle.type === 'sliding') {
        content += createSlidingPuzzle();
      } else if (puzzle.type === 'flexbox') {
        content += createFlexboxPuzzle();
      } else if (puzzle.type === 'canvas') {
        content += createCanvasPuzzle(puzzleId);
      } else if (puzzle.type === 'pipe') {
        content += createPipePuzzle(puzzleId);
      }

      $('#puzzleContent').html(content);
      $('#puzzleModal').addClass('active');

      if (puzzle.type === 'sliding') initSlidingPuzzle();
      if (puzzle.type === 'flexbox') initFlexboxPuzzle();
      if (puzzle.type === 'canvas') initCanvasPuzzle(puzzleId);
      if (puzzle.type === 'pipe') initPipePuzzle(puzzleId);
    }

    function closePuzzle() {
      $('#puzzleModal').removeClass('active');
    }

    function checkAnswer(puzzleId) {
      const puzzle = puzzleData[puzzleId];
      const answer = $('#puzzleAnswer').val().trim();

      if (answer === puzzle.answer) {
        $('#feedback').removeClass('error').addClass('success').text('Correct! Well done!');
        setTimeout(() => solvePuzzle(puzzleId), 1000);
      } else {
        $('#feedback').removeClass('success').addClass('error').text('Try again!');
      }
    }

    function solvePuzzle(puzzleId) {
      gameState.solved.add(puzzleId);
      $(`[data-puzzle="${puzzleId}"]`).addClass('unlocked');
      closePuzzle();
      updateProgress();

      if (gameState.solved.size === 6) {
        setTimeout(showVictory, 500);
      }
    }

    function updateProgress() {
      const percent = (gameState.solved.size / 6) * 100;
      $('#progressFill').css('width', `${percent}%`);
      $('#puzzlesSolved').text(`${gameState.solved.size} / 6`);
    }

    function showVictory() {
      clearInterval(gameState.timerInterval);
      $('#finalTime').text($('#timer').text());
      $('#victoryOverlay').addClass('active');
    }

    function resetGame() {
      gameState.solved.clear();
      gameState.startTime = Date.now();
      $('.puzzle-door').removeClass('unlocked');
      updateProgress();
      $('#victoryOverlay').removeClass('active');
      startTimer();
    }

    function createSlidingPuzzle() {
      return `
        <div class="puzzle-grid" id="slidingGrid" style="display:grid;grid-template-columns:repeat(3,80px);gap:5px;justify-content:center;">
        </div>
        <button class="puzzle-btn" onclick="checkSliding()">Check Solution</button>
        <div class="feedback" id="feedback"></div>
      `;
    }

    let slidingTiles = [1,2,3,4,5,6,7,8,0];

    function initSlidingPuzzle() {
      renderSlidingPuzzle();
    }

    function renderSlidingPuzzle() {
      const grid = $('#slidingGrid');
      grid.empty();
      slidingTiles.forEach((num, idx) => {
        const tile = $('<div>')
          .css({
            width: '80px', height: '80px',
            background: num === 0 ? 'transparent' : 'linear-gradient(135deg, #e94560, #f39c12)',
            borderRadius: '10px',
            display: 'flex', alignItems: 'center', justifyContent: 'center',
            fontSize: '24px', fontWeight: 'bold', cursor: num === 0 ? 'default' : 'pointer',
            border: num === 0 ? '2px dashed rgba(255,255,255,0.3)' : 'none'
          })
          .text(num === 0 ? '' : num)
          .data('index', idx);

        if (num !== 0) tile.on('click', () => slideTile(idx));
        grid.append(tile);
      });
    }

    function slideTile(idx) {
      const emptyIdx = slidingTiles.indexOf(0);
      const validMoves = [emptyIdx-1, emptyIdx+1, emptyIdx-3, emptyIdx+3];

      if (validMoves.includes(idx)) {
        if ((idx % 3 === 0 && emptyIdx % 3 === 2) || (idx % 3 === 2 && emptyIdx % 3 === 0)) return;

        [slidingTiles[idx], slidingTiles[emptyIdx]] = [slidingTiles[emptyIdx], slidingTiles[idx]];
        renderSlidingPuzzle();
      }
    }

    function checkSliding() {
      const solution = [1,2,3,4,5,6,7,8,0];
      if (JSON.stringify(slidingTiles) === JSON.stringify(solution)) {
        $('#feedback').removeClass('error').addClass('success').text('Solved!');
        setTimeout(() => solvePuzzle('puzzler'), 1000);
      } else {
        $('#feedback').removeClass('success').addClass('error').text('Not quite right. Keep trying!');
      }
    }

    function createFlexboxPuzzle() {
      return `
        <style>
          #flexContainer { display: flex; gap: 10px; padding: 20px; background: rgba(255,255,255,0.05); border-radius: 10px; min-height: 150px; }
          .flexBox { width: 60px; height: 60px; background: linear-gradient(135deg, #e94560, #f39c12); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: bold; }
        </style>
        <div style="margin-bottom:15px;">
          <label style="display:block;margin-bottom:5px;">justify-content:</label>
          <select id="justifyValue" class="puzzle-input" style="margin-bottom:10px;">
            <option value="">Select...</option>
            <option value="flex-start">flex-start</option>
            <option value="flex-end">flex-end</option>
            <option value="center">center</option>
            <option value="space-between">space-between</option>
            <option value="space-around">space-around</option>
          </select>
          <label style="display:block;margin-bottom:5px;">align-items:</label>
          <select id="alignValue" class="puzzle-input">
            <option value="">Select...</option>
            <option value="flex-start">flex-start</option>
            <option value="flex-end">flex-end</option>
            <option value="center">center</option>
            <option value="stretch">stretch</option>
          </select>
        </div>
        <div id="flexContainer">
          <div class="flexBox">1</div>
          <div class="flexBox">2</div>
          <div class="flexBox">3</div>
        </div>
        <button class="puzzle-btn" onclick="checkFlexbox()" style="margin-top:15px;">Check Answer</button>
        <div class="feedback" id="feedback"></div>
      `;
    }

    function initFlexboxPuzzle() {
      $('#justifyValue, #alignValue').on('change', updateFlexbox);
    }

    function updateFlexbox() {
      const justify = $('#justifyValue').val();
      const align = $('#alignValue').val();
      $('#flexContainer').css({
        'justify-content': justify || 'flex-start',
        'align-items': align || 'flex-start'
      });
    }

    function checkFlexbox() {
      const justify = $('#justifyValue').val();
      const align = $('#alignValue').val();

      if (justify === 'center' && align === 'center') {
        $('#feedback').removeClass('error').addClass('success').text('Perfect! You mastered flexbox!');
        setTimeout(() => solvePuzzle('flexbox'), 1000);
      } else {
        $('#feedback').removeClass('success').addClass('error').text('Not quite. Remember: center both!');
      }
    }

    function createCanvasPuzzle(puzzleId) {
      return `
        <canvas id="mirrorCanvas" width="300" height="200" style="display:block;margin:0 auto;border:2px solid rgba(255,255,255,0.2);border-radius:10px;"></canvas>
        <div style="margin-top:10px;display:flex;gap:10px;justify-content:center;">
          <button class="puzzle-btn" style="width:auto;padding:10px 20px;" onclick="clearCanvas()"><i class="fas fa-eraser"></i> Clear</button>
          <button class="puzzle-btn" style="width:auto;padding:10px 20px;" onclick="checkCanvas()"><i class="fas fa-check"></i> Check</button>
        </div>
        <div class="feedback" id="feedback"></div>
      `;
    }

    let canvasCtx, isDrawing = false;

    function initCanvasPuzzle(puzzleId) {
      const canvas = document.getElementById('mirrorCanvas');
      canvasCtx = canvas.getContext('2d');
      canvasCtx.fillStyle = 'rgba(255,255,255,0.1)';
      canvasCtx.fillRect(0, 0, canvas.width, canvas.height);
      canvasCtx.strokeStyle = '#e94560';
      canvasCtx.lineWidth = 3;
      canvasCtx.lineCap = 'round';

      canvasCtx.beginPath();
      canvasCtx.moveTo(150, 20);
      canvasCtx.lineTo(150, 180);
      canvasCtx.moveTo(20, 100);
      canvasCtx.lineTo(280, 100);
      canvasCtx.stroke();

      canvas.addEventListener('mousedown', startDrawing);
      canvas.addEventListener('mousemove', draw);
      canvas.addEventListener('mouseup', stopDrawing);
    }

    function startDrawing(e) {
      isDrawing = true;
      canvasCtx.beginPath();
      const rect = e.target.getBoundingClientRect();
      canvasCtx.moveTo(e.clientX - rect.left, e.clientY - rect.top);
    }

    function draw(e) {
      if (!isDrawing) return;
      const rect = e.target.getBoundingClientRect();
      canvasCtx.lineTo(e.clientX - rect.left, e.clientY - rect.top);
      canvasCtx.stroke();

      const x = e.clientX - rect.left;
      const mirrorX = 300 - x;
      canvasCtx.lineTo(mirrorX, e.clientY - rect.top);
      canvasCtx.stroke();
    }

    function stopDrawing() { isDrawing = false; }

    function clearCanvas() {
      const canvas = document.getElementById('mirrorCanvas');
      canvasCtx.fillStyle = 'rgba(255,255,255,0.1)';
      canvasCtx.fillRect(0, 0, canvas.width, canvas.height);
    }

    function checkCanvas() {
      $('#feedback').removeClass('error').addClass('success').text('Drawing verified! (Any symmetric pattern works)');
      setTimeout(() => solvePuzzle('mirror'), 1000);
    }

    function createPipePuzzle(puzzleId) {
      return `
        <div class="pipe-grid" id="pipeGrid"></div>
        <button class="puzzle-btn" onclick="checkPipe()" style="margin-top:15px;">Check Connection</button>
        <div class="feedback" id="feedback"></div>
      `;
    }

    const pipeTypes = ['│', '─', '┐', '┌', '└', '┘', '├', '┤', '┬', '┴', '┼'];
    let pipeGrid = [];

    function initPipePuzzle(puzzleId) {
      pipeGrid = [
        ['─', '─', '┐', '│', '┌', '─'],
        ['│', '┌', '┘', '│', '└', '┘'],
        ['┐', '└', '─', '┤', '─', '│'],
        ['│', '─', '┐', '┘', '│', '┌'],
        ['├', '│', '└', '─', '┐', '│'],
        ['─', '┘', '─', '─', '└', '─']
      ];
      renderPipePuzzle();
    }

    function renderPipePuzzle() {
      const grid = $('#pipeGrid');
      grid.empty();
      grid.css('display', 'grid');
      grid.css('grid-template-columns', 'repeat(6, 50px)');
      grid.css('gap', '2px');

      for (let r = 0; r < 6; r++) {
        for (let c = 0; c < 6; c++) {
          const cell = $('<div>')
            .addClass('pipe-cell')
            .text(pipeGrid[r][c])
            .data('row', r)
            .data('col', c)
            .on('click', function() { rotatePipe(r, c); });
          grid.append(cell);
        }
      }
    }

    function rotatePipe(r, c) {
      const idx = pipeTypes.indexOf(pipeGrid[r][c]);
      pipeGrid[r][c] = pipeTypes[(idx + 1) % pipeTypes.length];
      renderPipePuzzle();
    }

    function checkPipe() {
      $('#feedback').removeClass('success').addClass('error').text('Path not complete. Keep rotating!');
      setTimeout(() => {
        $('#feedback').hide();
      }, 2000);
    }

    $(window).on('beforeunload', function() {
      if (gameState.timerInterval) clearInterval(gameState.timerInterval);
    });
  </script>
</body>
</html>
