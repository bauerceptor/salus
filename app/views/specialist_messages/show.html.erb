<div class="wa-app">

  <!-- Left: Conversation List -->
  <aside class="wa-conversations">
    <div class="wa-conversations__header">
      <h1 class="wa-conversations__title">Chats</h1>
    </div>
    <div class="wa-conversations__list">
      <% if @conversations.any? %>
        <% @conversations.each do |msg| %>
          <% last_message = current_account.specialist_messages.where(specialist_id: msg.specialist_id).order(created_at: :desc).first %>
          <% unread_count = current_account.specialist_messages.where(specialist_id: msg.specialist_id, is_read: false, sender_type: 'specialist').count %>
          <%= link_to patient_message_path(last_message), class: "wa-conversation-item" do %>
            <div class="wa-conversation-item__avatar">
              <i class="ri-user-3-line"></i>
            </div>
            <div class="wa-conversation-item__content">
              <div class="wa-conversation-item__row">
                <span class="wa-conversation-item__name">Dr. <%= msg.specialist.account.full_name %></span>
                <span class="wa-conversation-item__time"><%= last_message.created_at.strftime("%H:%M") %></span>
              </div>
              <div class="wa-conversation-item__row">
                <span class="wa-conversation-item__preview">
                  <% if unread_count > 0 %>
                    <span class="wa-conversation-item__typing"></span>
                  <% else %>
                    <% if last_message.reply_from_specialist? %>
                      <i class="ri-check-line"></i>
                    <% end %>
                  <% end %>
                  <%= last_message.subject %>
                </span>
                <% if unread_count > 0 %>
                  <span class="wa-conversation-item__badge"><%= unread_count %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="wa-conversations__empty">
          <p>No conversations yet</p>
        </div>
      <% end %>
    </div>
  </aside>

  <!-- Right: Chat Screen -->
  <main class="wa-chat">
    <% if @message %>
      <header class="wa-chat__header">
        <div class="wa-chat__user">
          <div class="wa-chat__avatar">
            <i class="ri-user-3-line"></i>
          </div>
          <div class="wa-chat__info">
            <h2 class="wa-chat__name">Dr. <%= @message.specialist.account.full_name %></h2>
            <p class="wa-chat__status">online</p>
          </div>
        </div>
      </header>

      <div class="wa-chat__messages" id="messages-container">
        <% @conversation.each do |msg| %>
          <% is_sent = msg.reply_from_specialist? %>
          <div class="wa-msg wa-msg--<%= is_sent ? 'out' : 'in' %>">
            <div class="wa-msg__bubble">
              <% if msg.attachments.any? %>
                <div class="wa-msg__attachments">
                  <% msg.attachments.each do |attachment| %>
                    <% case attachment.file_type %>
                    <% when 'image' %>
                      <img src="<%== attachment.url %>" class="wa-msg__image" alt="">
                    <% when 'voice', 'audio' %>
                      <audio controls class="wa-msg__audio"><source src="<%== attachment.url %>" type="<%= attachment.content_type %>"></audio>
                    <% when 'video' %>
                      <video controls class="wa-msg__video"><source src="<%== attachment.url %>" type="<%= attachment.content_type %>"></video>
                    <% else %>
                      <div class="wa-msg__file">
                        <i class="ri-file-line"></i>
                        <span><%= attachment.filename %></span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
              <% if msg.body.present? %>
                <p class="wa-msg__text"><%= msg.body %></p>
              <% end %>
              <div class="wa-msg__meta">
                <span class="wa-msg__time"><%= msg.created_at.strftime("%H:%M") %></span>
                <% unless is_sent %>
                  <i class="<%= msg.is_read ? 'ri-check-double-line wa-msg__read' : 'ri-check-line' %>"></i>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="wa-chat__input">
        <button class="wa-chat__tool"><i class="ri-emoji-line"></i></button>
        <div class="wa-chat__field">
          <textarea id="message-body" rows="1" placeholder="Message"></textarea>
        </div>
        <button class="wa-chat__send" id="send-message">
          <i class="ri-send-line"></i>
        </button>
      </div>
    <% else %>
      <div class="wa-chat__placeholder">
        <div class="wa-chat__placeholder-icon">
          <i class="ri-chat-smile-3-line"></i>
        </div>
        <p>Select a conversation</p>
      </div>
    <% end %>
  </main>
</div>

<style>
* {
  box-sizing: border-box;
}

.wa-app {
  display: flex;
  height: 100vh;
  width: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #ddd;
}

/* Conversations Sidebar */
.wa-conversations {
  width: 30%;
  min-width: 280px;
  max-width: 380px;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.wa-conversations__header {
  padding: 15px 16px;
  background: #f0f2f5;
  border-bottom: 1px solid #e0e0e0;
}

.wa-conversations__title {
  font-size: 20px;
  font-weight: 600;
  color: #111;
  margin: 0;
}

.wa-conversations__list {
  flex: 1;
  overflow-y: auto;
}

.wa-conversations__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200px;
  color: #667781;
}

.wa-conversation-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s;
}

.wa-conversation-item:hover {
  background: #f5f5f5;
}

.wa-conversation-item__avatar {
  width: 48px;
  height: 48px;
  background: #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 22px;
  flex-shrink: 0;
}

.wa-conversation-item__content {
  flex: 1;
  min-width: 0;
}

.wa-conversation-item__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.wa-conversation-item__name {
  font-size: 16px;
  font-weight: 500;
  color: #111;
}

.wa-conversation-item__time {
  font-size: 12px;
  color: #667781;
  flex-shrink: 0;
}

.wa-conversation-item__preview {
  font-size: 14px;
  color: #667781;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  gap: 4px;
}

.wa-conversation-item__typing {
  width: 8px;
  height: 8px;
  background: #00a884;
  border-radius: 50%;
  flex-shrink: 0;
}

.wa-conversation-item__badge {
  background: #00a884;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 10px;
  flex-shrink: 0;
}

/* Chat Screen */
.wa-chat {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #efeae2;
}

.wa-chat__header {
  padding: 10px 16px;
  background: #f0f2f5;
  border-bottom: 1px solid #e0e0e0;
}

.wa-chat__user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.wa-chat__avatar {
  width: 38px;
  height: 38px;
  background: #00a884;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 18px;
}

.wa-chat__name {
  font-size: 16px;
  font-weight: 500;
  color: #111;
  margin: 0;
}

.wa-chat__status {
  font-size: 13px;
  color: #667781;
  margin: 0;
}

/* Messages */
.wa-chat__messages {
  flex: 1;
  overflow-y: auto;
  padding: 8px 12%;
}

.wa-msg {
  display: flex;
  margin-bottom: 4px;
}

.wa-msg--in {
  justify-content: flex-start;
}

.wa-msg--out {
  justify-content: flex-end;
}

/* Bubble with tail */
.wa-msg__bubble {
  max-width: 55%;
  padding: 6px 8px 4px 8px;
  position: relative;
  border-radius: 7.5px;
}

/* Received bubble - white with left tail */
.wa-msg--in .wa-msg__bubble {
  background: #fff;
  box-shadow: 0 1px 0.5px rgba(11, 20, 26, 0.13);
}

/* Tail for received (left side points to sender) */
.wa-msg--in .wa-msg__bubble::before {
  content: '';
  position: absolute;
  left: -8px;
  top: 0;
  width: 0;
  height: 0;
  border-top: 10px solid transparent;
  border-bottom: 10px solid transparent;
  border-right: 10px solid #fff;
}

/* Sent bubble - green with right tail */
.wa-msg--out .wa-msg__bubble {
  background: #dcf8c6;
}

/* Tail for sent (right side points to receiver) */
.wa-msg--out .wa-msg__bubble::after {
  content: '';
  position: absolute;
  right: -8px;
  top: 0;
  width: 0;
  height: 0;
  border-top: 10px solid transparent;
  border-bottom: 10px solid transparent;
  border-left: 10px solid #dcf8c6;
}

.wa-msg__text {
  font-size: 14.2px;
  line-height: 1.35;
  color: #111;
  margin: 0;
  word-wrap: break-word;
}

.wa-msg__attachments {
  margin-bottom: 4px;
}

.wa-msg__image {
  max-width: 260px;
  border-radius: 6px;
  display: block;
}

.wa-msg__audio {
  height: 30px;
  width: 200px;
}

.wa-msg__video {
  max-width: 260px;
  border-radius: 6px;
}

.wa-msg__file {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  background: rgba(0,0,0,0.05);
  border-radius: 6px;
  font-size: 13px;
}

.wa-msg__meta {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 3px;
  margin-top: 2px;
}

.wa-msg__time {
  font-size: 11px;
  color: #667781;
}

.wa-msg__read {
  color: #53bdeb;
  font-size: 16px;
}

/* Input */
.wa-chat__input {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: #f0f2f5;
}

.wa-chat__tool {
  width: 44px;
  height: 44px;
  background: transparent;
  border: none;
  border-radius: 50%;
  color: #54656f;
  font-size: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wa-chat__tool:hover {
  background: rgba(84, 101, 111, 0.1);
}

.wa-chat__field {
  flex: 1;
  background: #fff;
  border-radius: 24px;
  padding: 8px 16px;
}

.wa-chat__field textarea {
  width: 100%;
  border: none;
  background: transparent;
  resize: none;
  font-size: 15px;
  line-height: 1.4;
  max-height: 100px;
  outline: none;
}

.wa-chat__send {
  width: 48px;
  height: 48px;
  background: #00a884;
  border: none;
  border-radius: 50%;
  color: #fff;
  font-size: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Placeholder */
.wa-chat__placeholder {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f0f2f5;
  color: #667781;
}

.wa-chat__placeholder-icon {
  font-size: 80px;
  margin-bottom: 16px;
  opacity: 0.3;
}

.wa-chat__placeholder p {
  font-size: 16px;
}
</style>

<script>
(function() {
  var chat = document.querySelector('.wa-chat');
  if (!chat) return;

  var body = document.getElementById('message-body');
  var sendBtn = document.getElementById('send-message');

  if (body) {
    body.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 100) + 'px';
    });

    body.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', sendMessage);
  }

  function sendMessage() {
    if (!body || !body.value.trim()) return;

    var specialistId = '<%= @message&.specialist_id %>';
    if (!specialistId) return;

    var formData = new FormData();
    formData.append('specialist_message[body]', body.value.trim());
    formData.append('specialist_message[specialist_id]', specialistId);

    fetch('/specialist-messages', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
        'Accept': 'text/vnd.turbo-stream.html'
      },
      body: formData
    }).then(function() {
      if (body) {
        body.value = '';
        body.style.height = 'auto';
      }
    });
  }

  var container = document.getElementById('messages-container');
  if (container) {
    container.scrollTop = container.scrollHeight;
  }
})();
</script>