<div class="salus-shop">
  <div class="salus-shop__roof">
    <div class="salus-shop__curved-plant">
      <div class="salus-shop__curved-plant-extension">
        <span class="salus-shop__curved-plant-extension-leaves"></span>
      </div>
    </div>

    <div class="salus-shop__roof-pot-flower salus-shop__roof-pot-flower--first"></div>
    <div class="salus-shop__roof-pot-flower-wrapper">
      <div class="salus-shop__roof-pot-flower salus-shop__roof-pot-flower--second"></div>
    </div>
    <div class="salus-shop__roof-pot-flower salus-shop__roof-pot-flower--third"></div>

    <div class="salus-shop__roof-cactus"></div>

    <div class="salus-shop__name-container">
      <span class="salus-shop__name">Salus</span>
    </div>
  </div>

  <div class="salus-shop__front">
    <div class="salus-shop__window">
      <span class="salus-shop__window-vines salus-shop__window-vines--curve"></span>

      <div class="salus-shop__window-red-plant">
        <span class="salus-shop__window-red-plant-leaves"></span>
        <span class="salus-shop__window-red-plant-leaves salus-shop__window-red-plant-leaves--second"></span>
      </div>
      <div class="salus-shop__window-pot-flower">
        <span class="salus-shop__window-pot-flower-leaves"></span>
        <span class="salus-shop__window-pot-flower-leaves salus-shop__window-pot-flower-leaves--second"></span>
      </div>
      <span class="salus-shop__window-vines salus-shop__window-vines--straight"></span>
    </div>
    <div class="salus-shop__window-bottom"></div>
    <div class="salus-shop__door">
      <div class="salus-shop__door-inner">
        <span class="salus-shop__door-mirror-shines"></span>
      </div>
    </div>
  </div>

  <div class="salus-shop__floor-flower-wrapper salus-shop__floor-flower-wrapper--first">
    <span class="salus-shop__floor-flower"></span>
    <span class="salus-shop__floor-pot"></span>
  </div>

  <div class="salus-shop__floor-flower-wrapper salus-shop__floor-flower-wrapper--second">
    <span class="salus-shop__floor-flower"></span>
    <span class="salus-shop__floor-pot"></span>
  </div>

  <div class="salus-shop__floor-pot-flower"></div>

  <div class="salus-shop__floor"></div>
</div>
