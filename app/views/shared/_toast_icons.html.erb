<div class="toast-wrapper">
  <div class="toast-icons">
    <label for="t-help-<%= id ||= 'default' %>" class="toast-icon icon-help"></label>
    <label for="t-success-<%= id ||= 'default' %>" class="toast-icon icon-success"></label>
    <label for="t-warning-<%= id ||= 'default' %>" class="toast-icon icon-warning"></label>
    <label for="t-error-<%= id ||= 'default' %>" class="toast-icon icon-error"></label>
  </div>
</div>
