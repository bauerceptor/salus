<input type="checkbox" name="t-success" id="t-success-<%= id ||= 'default' %>" <%= checked ? 'checked' : '' %>>
<div class="toast-panel">
  <div class="toast-item success">
    <div class="toast success">
      <label for="t-success-<%= id ||= 'default' %>" class="close"></label>
      <h3>Success!</h3>
      <p>Your message has been sent successfully.</p>
    </div>
  </div>
</div>
