<input type="checkbox" name="t-help" id="t-help-<%= id ||= 'default' %>" <%= checked ? 'checked' : '' %>>
<div class="toast-panel">
  <div class="toast-item help">
    <div class="toast help">
      <label for="t-help-<%= id ||= 'default' %>" class="close"></label>
      <h3>Help!</h3>
      <p>Do you have a problem? Just use this <a href="#">contact form</a>.</p>
    </div>
  </div>
</div>
