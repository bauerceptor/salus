<!-- Three Dot / FAB Menu Component -->
<!-- Usage: Render this partial and use CSS checkbox hack for toggle -->
<!-- The checkbox input acts as the toggle trigger -->
<div class="fab-menu">
  <input type="checkbox" class="fab-menu__checkbox" />

  <div class="fab-menu__trigger">
    <div class="fab-menu__dots">
      <span class="fab-menu__dot fab-menu__dot--first"></span>
      <span class="fab-menu__dot fab-menu__dot--second"></span>
      <span class="fab-menu__dot fab-menu__dot--third"></span>
    </div>
  </div>

  <div class="fab-menu__bar">
    <div class="fab-menu__items">
      <span class="fab-menu__item fab-menu__item--first">
        <i class="ri-heart-line"></i>
      </span>
      <span class="fab-menu__item fab-menu__item--second">
        <i class="ri-chat-3-line"></i>
      </span>
      <span class="fab-menu__item fab-menu__item--third">
        <i class="ri-download-line"></i>
      </span>
      <span class="fab-menu__item fab-menu__item--fourth">
        <i class="ri-share-line"></i>
      </span>
    </div>
  </div>
</div>
