<script>
(function() {
  var chat = document.querySelector('.wa-chat');
  if (!chat) return;

  var body = document.getElementById('message-body');
  var sendBtn = document.getElementById('send-message');
  var attachBtn = document.getElementById('attach-btn');
  var attachMenu = document.getElementById('attach-menu');
  var voiceBtn = document.getElementById('voice-btn');
  var micIcon = document.getElementById('mic-icon');
  var stopIcon = document.getElementById('stop-icon');
  var recordingDuration = document.getElementById('recording-duration');

  var voiceRecorder = null;
  var mediaRecorder = null;
  var audioChunks = [];

  if (body) {
    body.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 100) + 'px';
    });

    body.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', sendMessage);
  }

  if (attachBtn && attachMenu) {
    attachBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      attachMenu.classList.toggle('show');
    });

    document.addEventListener('click', function(e) {
      if (!attachMenu.contains(e.target) && e.target !== attachBtn) {
        attachMenu.classList.remove('show');
      }
    });

    var fileInputs = attachMenu.querySelectorAll('input[type="file"]');
    fileInputs.forEach(function(input) {
      input.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
          handleFileUpload(this.files[0], this.accept);
          attachMenu.classList.remove('show');
        }
      });
    });
  }

  if (voiceBtn) {
    voiceBtn.addEventListener('click', toggleVoiceRecording);
  }

  function toggleVoiceRecording() {
    if (!voiceRecorder && !mediaRecorder) {
      startRecording();
    } else if (mediaRecorder && mediaRecorder.state === 'recording') {
      stopRecording();
    }
  }

  function startRecording() {
    navigator.mediaDevices.getUserMedia({ audio: true })
      .then(function(stream) {
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];

        mediaRecorder.ondataavailable = function(e) {
          audioChunks.push(e.data);
        };

        mediaRecorder.onstop = function() {
          var audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
          sendVoiceMessage(audioBlob);
          stream.getTracks().forEach(function(track) { track.stop(); });
        };

        mediaRecorder.start();
        voiceBtn.classList.add('recording');
        micIcon.classList.add('hidden');
        stopIcon.classList.remove('hidden');
        recordingDuration.classList.remove('hidden');
        updateDuration();
      })
      .catch(function(err) {
        console.error('Error accessing microphone:', err);
      });
  }

  function stopRecording() {
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      mediaRecorder.stop();
      voiceBtn.classList.remove('recording');
      micIcon.classList.remove('hidden');
      stopIcon.classList.add('hidden');
      recordingDuration.classList.add('hidden');
    }
  }

  var recordingStartTime;
  function updateDuration() {
    recordingStartTime = Date.now();
    durationInterval = setInterval(function() {
      var elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
      var minutes = Math.floor(elapsed / 60);
      var seconds = elapsed % 60;
      recordingDuration.textContent = minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
    }, 1000);
  }

  var durationInterval;

  function sendVoiceMessage(audioBlob) {
    var chatroomId = document.querySelector('[data-chatroom-id]')?.dataset.chatroomId;
    if (!chatroomId) return;

    var formData = new FormData();
    formData.append('chatroom_message[body]', 'Voice message');
    formData.append('chatroom_message[message_type]', 'audio');
    formData.append('attachment', audioBlob, 'voice_message.webm');

    fetch('/<%= I18n.locale %>/chatrooms/' + chatroomId + '/chatroom_messages', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: formData
    }).then(function(response) {
      if (response.ok) {
        return response.json();
      }
    }).catch(function(error) {
      console.error('Send voice error:', error);
    });

    if (durationInterval) clearInterval(durationInterval);
  }

  function handleFileUpload(file, acceptType) {
    var chatroomId = document.querySelector('[data-chatroom-id]')?.dataset.chatroomId;
    if (!chatroomId) return;

    var formData = new FormData();
    var messageType = 'document';

    if (file.type.startsWith('image/')) {
      messageType = 'photo';
    } else if (file.type.startsWith('video/')) {
      messageType = 'video';
    } else if (file.type.startsWith('audio/')) {
      messageType = 'audio';
    }

    formData.append('chatroom_message[body]', file.name);
    formData.append('chatroom_message[message_type]', messageType);
    formData.append('attachment', file);

    fetch('/<%= I18n.locale %>/chatrooms/' + chatroomId + '/chatroom_messages', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: formData
    }).then(function(response) {
      if (response.ok) {
        return response.json();
      }
    }).catch(function(error) {
      console.error('Send error:', error);
    });
  }

  function sendMessage() {
    if (!body || !body.value.trim()) return;

    var chatroomId = document.querySelector('[data-chatroom-id]')?.dataset.chatroomId;
    if (!chatroomId) return;

    var formData = new FormData();
    formData.append('chatroom_message[body]', body.value.trim());

    fetch('/<%= I18n.locale %>/chatrooms/' + chatroomId + '/chatroom_messages', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: formData
    }).then(function(response) {
      if (response.ok) {
        body.value = '';
        body.style.height = 'auto';
      }
    }).catch(function(error) {
      console.error('Send error:', error);
    });
  }

  var container = document.getElementById('messages-container');
  if (container) {
    container.scrollTop = container.scrollHeight;
  }

  setTimeout(function() {
    var container = document.getElementById('messages-container');
    if (container) {
      container.scrollTop = container.scrollHeight;
    }
  }, 100);
})();
</script>