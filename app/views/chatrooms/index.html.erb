<div class="wa-app">

  <aside class="wa-conversations">
    <div class="wa-conversations__header">
      <h1 class="wa-conversations__title">Chats</h1>
    </div>
    <div class="wa-conversations__list">
      <% if @chatrooms.any? %>
        <% @chatrooms.each do |chatroom| %>
          <% other_user = chatroom.other_participant(current_account) %>
          <% unread = chatroom.unread_count(current_account) %>
          <%= link_to chatrooms_path(id: chatroom.id, locale: I18n.locale), class: "wa-conversation-item #{@chatroom&.id == chatroom.id ? 'wa-conversation-item--active' : ''}" do %>
            <div class="wa-conversation-item__avatar">
              <% if other_user.image.present? && other_user.image.attached? %>
                <%= image_tag other_user.image, class: "rounded-full object-cover w-full h-full" %>
              <% else %>
                <i class="ri-user-3-line"></i>
              <% end %>
            </div>
            <div class="wa-conversation-item__content">
              <div class="wa-conversation-item__row">
                <span class="wa-conversation-item__name"><%= other_user.username %></span>
                <% if chatroom.last_message %>
                  <span class="wa-conversation-item__time"><%= chatroom.last_message.created_at.strftime("%H:%M") %></span>
                <% end %>
              </div>
              <div class="wa-conversation-item__row">
                <span class="wa-conversation-item__preview">
                  <% if chatroom.last_message %>
                    <% if unread > 0 %>
                      <span class="wa-conversation-item__typing"></span>
                    <% end %>
                    <%= chatroom.last_message.body.truncate(40) %>
                  <% else %>
                    No messages yet
                  <% end %>
                </span>
                <% if unread > 0 %>
                  <span class="wa-conversation-item__badge"><%= unread %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="wa-conversations__empty">
          <p>No conversations yet</p>
        </div>
      <% end %>
    </div>
  </aside>

  <main class="wa-chat">
    <% if @chatroom && @other_participant %>
      <header class="wa-chat__header">
        <div class="wa-chat__user">
          <div class="wa-chat__avatar">
            <% if @other_participant.image.present? && @other_participant.image.attached? %>
              <%= image_tag @other_participant.image, class: "rounded-full object-cover w-full h-full" %>
            <% else %>
              <i class="ri-user-3-line"></i>
            <% end %>
          </div>
          <div class="wa-chat__info">
            <h2 class="wa-chat__name"><%= @other_participant.username %></h2>
            <% if @other_participant.online_status == "online" %>
              <p class="wa-chat__status">online</p>
            <% elsif @other_participant.last_seen_at %>
              <p class="wa-chat__status">Last seen <%= time_ago_in_words(@other_participant.last_seen_at) %> ago</p>
            <% else %>
              <p class="wa-chat__status">offline</p>
            <% end %>
          </div>
        </div>
        <div class="wa-chat__actions">
          <button class="wa-chat__action" title="Voice call">
            <i class="ri-phone-line"></i>
          </button>
          <button class="wa-chat__action" title="Video call">
            <i class="ri-video-line"></i>
          </button>
        </div>
      </header>

      <div class="wa-chat__messages" id="messages-container" data-chatroom-id="<%= @chatroom.id %>" data-current-account-id="<%= current_account.id %>">
        <% if @messages.any? %>
          <% @messages.each do |message| %>
            <% is_sent = message.account_id == current_account.id %>
            <div class="wa-msg wa-msg--<%= is_sent ? 'out' : 'in' %>">
              <div class="wa-msg__bubble">
                <% if message.message_type == 'photo' && message.attachment.attached? %>
                  <img src="<%= url_for(message.attachment) %>" class="wa-msg__image" alt="">
                <% elsif message.message_type == 'video' && message.attachment.attached? %>
                  <video controls class="wa-msg__video"><source src="<%= url_for(message.attachment) %>" type="<%= message.attachment.content_type %>"></video>
                <% elsif message.message_type == 'audio' && message.attachment.attached? %>
                  <audio controls class="wa-msg__audio"><source src="<%= url_for(message.attachment) %>" type="<%= message.attachment.content_type %>"></audio>
                <% elsif message.message_type == 'document' && message.attachment.attached? %>
                  <div class="wa-msg__file">
                    <i class="ri-file-line"></i>
                    <span><%= message.body %></span>
                  </div>
                <% end %>
                <% if message.body.present? && message.message_type != 'document' %>
                  <p class="wa-msg__text"><%= message.body %></p>
                <% end %>
                <div class="wa-msg__meta">
                  <span class="wa-msg__time"><%= message.created_at.strftime("%H:%M") %></span>
                  <% if is_sent %>
                    <i class="<%= message.read_by?(current_account) ? 'ri-check-double-line wa-msg__read' : 'ri-check-line' %>"></i>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="wa-chat__messages-empty">
            <p>No messages yet. Say hello!</p>
          </div>
        <% end %>
      </div>

      <div class="wa-chat__input">
        <button class="wa-chat__tool" id="attach-btn" title="Attach">
          <i class="ri-attachment-2"></i>
        </button>
        <div class="wa-chat__attach-menu" id="attach-menu">
          <label class="wa-chat__attach-option">
            <div class="wa-chat__attach-icon wa-chat__attach-icon--photo">
              <i class="ri-image-line"></i>
            </div>
            <span>Photo</span>
            <input type="file" id="attachment-photo" class="hidden" accept="image/*" />
          </label>
          <label class="wa-chat__attach-option">
            <div class="wa-chat__attach-icon wa-chat__attach-icon--video">
              <i class="ri-vidicon-line"></i>
            </div>
            <span>Video</span>
            <input type="file" id="attachment-video" class="hidden" accept="video/*" />
          </label>
          <label class="wa-chat__attach-option">
            <div class="wa-chat__attach-icon wa-chat__attach-icon--doc">
              <i class="ri-file-line"></i>
            </div>
            <span>Document</span>
            <input type="file" id="attachment-doc" class="hidden" accept=".pdf,.doc,.docx,.txt" />
          </label>
        </div>
        <div id="voice-recorder-container" class="wa-chat__voice-btn">
          <button type="button" id="voice-btn" class="wa-chat__mic-btn" title="Voice">
            <svg id="mic-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
            </svg>
            <svg id="stop-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <rect x="6" y="6" width="12" height="12" rx="2" stroke-width="2" stroke="currentColor" fill="currentColor" />
            </svg>
          </button>
          <span id="recording-duration" class="text-sm text-[#667781] hidden font-mono">0:00</span>
        </div>
        <div class="wa-chat__field">
          <textarea id="message-body" rows="1" placeholder="Message"></textarea>
        </div>
        <button class="wa-chat__send" id="send-message">
          <i class="ri-send-line"></i>
        </button>
      </div>
    <% else %>
      <div class="wa-chat__placeholder">
        <div class="wa-chat__placeholder-icon">
          <i class="ri-chat-smile-3-line"></i>
        </div>
        <p>Select a conversation</p>
      </div>
    <% end %>
  </main>
</div>

<style>
