<script>
(function() {
  const form = document.getElementById('new-message-form');
  const messageBody = document.getElementById('message-body');
  const messagesContainer = document.getElementById('messages-container');
  const chatroomId = messagesContainer?.dataset.chatroomId;
  const voiceBtn = document.getElementById('voice-btn');
  const micIcon = document.getElementById('mic-icon');
  const stopIcon = document.getElementById('stop-icon');
  const recordingDuration = document.getElementById('recording-duration');

  let voiceRecorder = null;

  if (!form || !messageBody) return;

  function initVoiceRecorder() {
    if (voiceRecorder) return;

    voiceRecorder = new VoiceRecorder({
      chatroomId: chatroomId,
      onRecordingStateChange: function(isRecording) {
        if (isRecording) {
          micIcon.classList.add('hidden');
          stopIcon.classList.remove('hidden');
          recordingDuration.classList.remove('hidden');
          messageBody.disabled = true;
          messageBody.placeholder = 'Recording...';
        } else {
          micIcon.classList.remove('hidden');
          stopIcon.classList.add('hidden');
          recordingDuration.classList.add('hidden');
          recordingDuration.textContent = '0:00';
          messageBody.disabled = false;
          messageBody.placeholder = 'Type a message...';
        }
      },
      onDurationUpdate: function(duration) {
        recordingDuration.textContent = voiceRecorder.formatDuration(duration);
      },
      onError: function(err) {
        console.error('Voice recording error:', err);
        showToast('Failed to record audio');
        if (voiceRecorder && voiceRecorder.recording) {
          voiceRecorder.cancelRecording();
        }
      }
    });
  }

  voiceBtn?.addEventListener('click', function() {
    initVoiceRecorder();

    if (!voiceRecorder.recording) {
      voiceRecorder.startRecording();
    } else {
      voiceRecorder.stopRecording();
    }
  });

  messageBody.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  messageBody.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 150) + 'px';
  });

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    const body = messageBody.value.trim();
    if (!body) return;

    const formData = new FormData();
    formData.append('chatroom_message[body]', body);
    formData.append('message_type', 'text');

    fetch('/chatrooms/' + chatroomId + '/chatroom_messages', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: formData
    }).then(function(response) {
      if (response.ok) {
        messageBody.value = '';
        messageBody.style.height = 'auto';
        scrollToBottom();
      }
    });
  });

  function scrollToBottom() {
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }

  scrollToBottom();
})();

function showToast(message) {
  const toast = document.createElement('div');
  toast.className = 'toast toast-bottom toast-center z-50';
  toast.innerHTML = '<div class="badge bg-[#00a884] text-white gap-2 px-4 py-3"><span>' + message + '</span></div>';
  document.body.appendChild(toast);
  setTimeout(function() { toast.remove(); }, 2500);
}

window.copyMessageText = function(messageId) {
  const messageEl = document.querySelector('[data-message-id="' + messageId + '"]');
  const messageText = messageEl ? messageEl.querySelector('p')?.textContent || '' : '';
  if (messageText && navigator.clipboard) {
    navigator.clipboard.writeText(messageText).then(function() {
      showToast('Copied to clipboard');
    });
  }
};

window.replyToMessage = function(messageId) {
  const messageEl = document.querySelector('[data-message-id="' + messageId + '"]');
  const messageBody = document.getElementById('message-body');
  if (messageEl && messageBody) {
    const messageText = messageEl.querySelector('p')?.textContent || '';
    const username = messageEl.querySelector('.font-medium')?.textContent || 'User';
    messageBody.value = '@' + username + ': ' + (messageText || '[Media]') + '\n';
    messageBody.focus();
    messageBody.style.height = 'auto';
    messageBody.style.height = Math.min(messageBody.scrollHeight, 150) + 'px';
  }
};
</script>

<%= render "chatrooms/call_modal" %>

<script>
(function() {
  const voiceNotePlayers = new Map();

  function formatTime(seconds) {
    if (!seconds || isNaN(seconds) || !isFinite(seconds)) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return mins + ':' + secs.toString().padStart(2, '0');
  }

  function updateProgress(audio, waveformProgress, durationEl) {
    const playerData = voiceNotePlayers.get(audio._playerEl);
    if (!playerData || !playerData.isPlaying) return;

    if (audio.duration && audio.duration > 0 && audio.duration < Infinity) {
      const progress = (audio.currentTime / audio.duration) * 100;
      if (waveformProgress) waveformProgress.style.setProperty('width', progress + '%');
      if (durationEl) durationEl.textContent = formatTime(audio.currentTime) + ' / ' + formatTime(audio.duration);
    }

    if (audio._playerEl && playerData.isPlaying) {
      playerData.rafId = requestAnimationFrame(() => updateProgress(audio, waveformProgress, durationEl));
    }
  }

  function initVoiceNotePlayers() {
    document.querySelectorAll('.voice-note-player').forEach(function(playerEl) {
      if (voiceNotePlayers.has(playerEl)) return;

      const audioUrl = playerEl.dataset.audioUrl;
      const playBtn = playerEl.querySelector('.play-btn');
      const playIcon = playerEl.querySelector('.play-icon');
      const pauseIcon = playerEl.querySelector('.pause-icon');
      const waveformProgress = playerEl.querySelector('.waveform-progress');
      const durationEl = playerEl.querySelector('.duration');

      const audio = new Audio();
      audio.preload = 'metadata';
      audio.src = audioUrl;
      let isPlaying = false;

      audio._playerEl = playerEl;

      function startPlayback() {
        audio.play().then(() => {
          isPlaying = true;
          playIcon?.classList.add('hidden');
          pauseIcon?.classList.remove('hidden');
          updateProgress(audio, waveformProgress, durationEl);
        }).catch(err => {
          console.error('Playback error:', err);
          durationEl.textContent = 'Error';
        });
      }

      playBtn?.addEventListener('click', function() {
        if (isPlaying) {
          audio.pause();
          isPlaying = false;
          const playerData = voiceNotePlayers.get(playerEl);
          if (playerData?.rafId) {
            cancelAnimationFrame(playerData.rafId);
            playerData.rafId = null;
          }
          playIcon?.classList.remove('hidden');
          pauseIcon?.classList.add('hidden');
        } else {
          document.querySelectorAll('.voice-note-player').forEach(function(otherEl) {
            const otherData = voiceNotePlayers.get(otherEl);
            if (otherData && otherData.audio && !otherData.audio.paused) {
              otherData.audio.pause();
              otherData.isPlaying = false;
              otherEl.querySelector('.play-icon')?.classList.remove('hidden');
              otherEl.querySelector('.pause-icon')?.classList.add('hidden');
              otherEl.querySelector('.waveform-progress')?.style.setProperty('width', '0%');
            }
          });

          startPlayback();
        }
      });

      audio.addEventListener('loadedmetadata', function() {
        if (audio.duration && audio.duration > 0 && audio.duration < Infinity) {
          durationEl.textContent = '0:00 / ' + formatTime(audio.duration);
        }
      });

      audio.addEventListener('canplay', function() {
        if (audio.duration && audio.duration > 0 && audio.duration < Infinity) {
          durationEl.textContent = '0:00 / ' + formatTime(audio.duration);
        }
      });

      audio.addEventListener('pause', function() {
        isPlaying = false;
        const playerData = voiceNotePlayers.get(playerEl);
        if (playerData?.rafId) {
          cancelAnimationFrame(playerData.rafId);
          playerData.rafId = null;
        }
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
      });

      audio.addEventListener('ended', function() {
        isPlaying = false;
        const playerData = voiceNotePlayers.get(playerEl);
        if (playerData?.rafId) {
          cancelAnimationFrame(playerData.rafId);
          playerData.rafId = null;
        }
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
        waveformProgress?.style.setProperty('width', '0%');
        if (audio.duration && audio.duration > 0) {
          durationEl.textContent = formatTime(audio.duration) + ' / ' + formatTime(audio.duration);
        }
      });

      audio.addEventListener('error', function(e) {
        console.error('Audio error:', audio.error);
        durationEl.textContent = 'Error';
      });

      voiceNotePlayers.set(playerEl, { audio: audio, isPlaying: isPlaying, rafId: null });
    });
  }

  initVoiceNotePlayers();

  document.addEventListener('turbo:frame-load', initVoiceNotePlayers);
  document.addEventListener('DOMContentLoaded', initVoiceNotePlayers);
  window.addEventListener('voice-note-init', initVoiceNotePlayers);
})();

(function() {
  const messagesContainer = document.getElementById('messages-container');
  const chatroomId = messagesContainer?.dataset.chatroomId;
  const currentAccountId = parseInt(messagesContainer?.dataset.currentAccountId);
  const otherUserId = document.getElementById('start-audio-call')?.dataset.userId;
  const otherUsername = document.getElementById('start-audio-call')?.dataset.username;

  let callManager = null;

  const incomingCallModal = document.getElementById('incoming-call-modal');
  const callScreen = document.getElementById('call-screen');
  const outgoingCallScreen = document.getElementById('outgoing-call-screen');

  async function initCallManager() {
    if (callManager) return;

    callManager = new CallManager({
      currentUserId: currentAccountId,
      chatroomId: chatroomId,
      otherUserId: parseInt(otherUserId),
      otherUsername: otherUsername,
      onIncomingCall: handleIncomingCall,
      onCallEnded: handleCallEnded,
      onError: handleCallError
    });

    try {
      await callManager.initialize();
    } catch (err) {
      console.warn('CallManager initialization failed:', err.message);
    }
  }

  function handleIncomingCall(data) {
    const callerAvatar = document.getElementById('caller-avatar');
    const callerAvatarFallback = document.getElementById('caller-avatar-fallback');
    const callerName = document.getElementById('caller-name');
    const callTypeLabel = document.getElementById('call-type-label');

    callerName.textContent = data.callerName;

    if (data.callerAvatar) {
      callerAvatar.src = data.callerAvatar;
      callerAvatar.classList.remove('hidden');
      callerAvatarFallback.classList.add('hidden');
    } else {
      callerAvatar.classList.add('hidden');
      callerAvatarFallback.textContent = (data.callerName || 'U')[0].toUpperCase();
    }

    callTypeLabel.textContent = data.callType === 'video' ? 'Incoming video call...' : 'Incoming audio call...';

    incomingCallModal?.classList.remove('hidden');
  }

  function handleCallEnded(data) {
    hideAllCallScreens();
    if (data.enderName) {
      showToast(`${data.enderName} ended the call`);
    }
  }

  function handleCallError(err) {
    showToast(err.message || 'Call failed');
  }

  function hideAllCallScreens() {
    incomingCallModal?.classList.add('hidden');
    callScreen?.classList.add('hidden');
    outgoingCallScreen?.classList.add('hidden');
  }

  function showActiveCallScreen(callType, remoteName, remoteAvatar) {
    const remoteVideoEl = document.getElementById('remote-video-el');
    const remoteVideo = document.getElementById('remote-video');
    const remoteAvatarFallback = document.getElementById('remote-avatar-fallback');
    const callWithName = document.getElementById('call-with-name');
    const localVideoEl = document.getElementById('local-video-el');
    const localVideoOff = document.getElementById('local-video-off');
    const videoBtn = document.getElementById('video-btn');
    const videoOnIcon = document.getElementById('video-on-icon');
    const videoOffIcon = document.getElementById('video-off-icon');

    callWithName.textContent = remoteName || 'User';

    if (remoteAvatar) {
      remoteVideo.src = remoteAvatar;
      remoteVideo.classList.remove('hidden');
      remoteAvatarFallback.classList.add('hidden');
    } else {
      remoteVideo.classList.add('hidden');
      remoteAvatarFallback.textContent = (remoteName || 'U')[0].toUpperCase();
    }

    callScreen?.classList.remove('hidden');

    if (callManager) {
      const localStream = callManager.getLocalStream();
      if (localStream) {
        localVideoEl.srcObject = localStream;
      }
    }

    if (callType === 'video') {
      videoBtn?.classList.remove('hidden');
    } else {
      videoBtn?.classList.add('hidden');
    }
  }

  function showOutgoingCallScreen(remoteName, remoteAvatar) {
    const outgoingAvatar = document.getElementById('outgoing-avatar');
    const outgoingAvatarFallback = document.getElementById('outgoing-avatar-fallback');
    const outgoingCallWith = document.getElementById('outgoing-call-with');

    outgoingCallWith.textContent = remoteName || 'User';

    if (remoteAvatar) {
      outgoingAvatar.src = remoteAvatar;
      outgoingAvatar.classList.remove('hidden');
      outgoingAvatarFallback.classList.add('hidden');
    } else {
      outgoingAvatar.classList.add('hidden');
      outgoingAvatarFallback.textContent = (remoteName || 'U')[0].toUpperCase();
    }

    outgoingCallScreen?.classList.remove('hidden');
  }

  document.getElementById('start-audio-call')?.addEventListener('click', async function() {
    await initCallManager();
    if (callManager && otherUserId) {
      showOutgoingCallScreen(otherUsername);
      try {
        await callManager.startCall(parseInt(otherUserId), null, 'audio');
      } catch (err) {
        hideAllCallScreens();
        showToast(err.message);
      }
    }
  });

  document.getElementById('start-video-call')?.addEventListener('click', async function() {
    await initCallManager();
    if (callManager && otherUserId) {
      showOutgoingCallScreen(otherUsername);
      try {
        await callManager.startCall(parseInt(otherUserId), null, 'video');
      } catch (err) {
        hideAllCallScreens();
        showToast(err.message);
      }
    }
  });

  document.getElementById('accept-call-btn')?.addEventListener('click', async function() {
    if (callManager) {
      callManager.acceptCall();
      incomingCallModal?.classList.add('hidden');
      showActiveCallScreen(callManager.callType, otherUsername);
    }
  });

  document.getElementById('reject-call-btn')?.addEventListener('click', function() {
    if (callManager) {
      callManager.rejectCall();
    }
    incomingCallModal?.classList.add('hidden');
  });

  document.getElementById('end-call-btn')?.addEventListener('click', function() {
    if (callManager) {
      callManager.endCall();
    }
    hideAllCallScreens();
  });

  document.getElementById('cancel-outgoing-btn')?.addEventListener('click', function() {
    if (callManager) {
      callManager.endCall();
    }
    hideAllCallScreens();
  });

  document.getElementById('mute-btn')?.addEventListener('click', function() {
    if (callManager) {
      const isMuted = callManager.toggleMute();
      const micOnIcon = document.getElementById('mic-on-icon');
      const micOffIcon = document.getElementById('mic-off-icon');

      if (isMuted) {
        micOnIcon?.classList.add('hidden');
        micOffIcon?.classList.remove('hidden');
      } else {
        micOnIcon?.classList.remove('hidden');
        micOffIcon?.classList.add('hidden');
      }
    }
  });

  document.getElementById('video-btn')?.addEventListener('click', function() {
    if (callManager) {
      const isVideoOff = callManager.toggleVideo();
      const videoOnIcon = document.getElementById('video-on-icon');
      const videoOffIcon = document.getElementById('video-off-icon');
      const localVideoOff = document.getElementById('local-video-off');

      if (isVideoOff) {
        videoOnIcon?.classList.add('hidden');
        videoOffIcon?.classList.remove('hidden');
        localVideoOff?.classList.remove('hidden');
      } else {
        videoOnIcon?.classList.remove('hidden');
        videoOffIcon?.classList.add('hidden');
        localVideoOff?.classList.add('hidden');
      }
    }
  });

  window.addEventListener('call-state-change', function(e) {
    const { state, callType, duration } = e.detail;
    const callStatus = document.getElementById('call-status');

    if (state === 'connected') {
      callStatus.textContent = formatDuration(duration);
    } else if (state === 'calling') {
      callStatus.textContent = 'Calling...';
    }
  });

  function formatDuration(seconds) {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }

  setInterval(function() {
    if (callManager && callManager.callState === 'connected' && callManager.callStartTime) {
      const duration = Math.floor((Date.now() - callManager.callStartTime) / 1000);
      const callStatus = document.getElementById('call-status');
      if (callStatus) {
        callStatus.textContent = formatDuration(duration);
      }
    }
  }, 1000);
})();
</script>