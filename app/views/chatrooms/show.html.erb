<div class="flex flex-col h-[calc(100vh-4rem)]" style="background: linear-gradient(180deg, #8696a0 0%, #f8f9fa 8%, #f8f9fa 92%, #f8f9fa 100%);">
  <div class="bg-[#f0f2f5] border-b border-[#d1d7db] px-4 py-3">
    <div class="flex items-center gap-3">
      <%= link_to chatrooms_path, class: "btn btn-ghost btn-sm btn-circle" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <div class="avatar relative">
        <div class="w-10 h-10 rounded-full bg-[#00a884] text-white overflow-hidden">
          <% if @other_participant.image.present? && @other_participant.image.attached? %>
            <%= image_tag @other_participant.image, class: "rounded-full object-cover w-full h-full" %>
          <% else %>
            <span class="text-base font-semibold flex items-center justify-center h-full"><%= @other_participant.username.first.upcase %></span>
          <% end %>
        </div>
        <% if @other_participant.online_status == "online" %>
          <div class="absolute bottom-0 right-0 w-3 h-3 bg-[#00a884] rounded-full border-2 border-[#f0f2f5]"></div>
        <% end %>
      </div>
      <div>
        <h3 class="font-semibold text-[#111b21]"><%= @other_participant.username %></h3>
        <% if @other_participant.online_status == "online" %>
          <p class="text-xs text-[#667781]">Online</p>
        <% elsif @other_participant.last_seen_at %>
          <p class="text-xs text-[#667781]">Last seen <%= time_ago_in_words(@other_participant.last_seen_at) %> ago</p>
        <% else %>
          <p class="text-xs text-[#667781]">Offline</p>
        <% end %>
      </div>
      <%# <div class="ml-auto flex items-center gap-2">
        <button id="start-audio-call" class="btn btn-circle btn-ghost text-[#54656f] hover:bg-[#d1d7db]" data-user-id="<%= @other_participant.id %>" data-username="<%= @other_participant.username %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </button>
        <button id="start-video-call" class="btn btn-circle btn-ghost text-[#54656f] hover:bg-[#d1d7db]" data-user-id="<%= @other_participant.id %>" data-username="<%= @other_participant.username %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      </div> %>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto p-4" id="messages-container" data-chatroom-id="<%= @chatroom.id %>" data-current-account-id="<%= current_account.id %>">
    <% if @messages.any? %>
      <div class="messages space-y-2" id="messages-list">
        <% @messages.each do |message| %>
          <%= render "chatroom_messages/message", message: message, current_account: current_account %>
