          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <ul tabindex="0" class="dropdown-content z-50 menu p-2 shadow-xl bg-white rounded-2xl w-56">
          <li>
            <label class="flex items-center gap-3 cursor-pointer hover:bg-[#f0f2f5] rounded-xl px-4 py-3">
              <div class="w-10 h-10 rounded-full bg-[#d9fdd3] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#00a884]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="text-[#111b21] font-medium">Photo</span>
              </div>
              <input type="file" name="attachment" id="attachment-photo" class="hidden" accept="image/*" />
            </label>
          </li>
          <li>
            <label class="flex items-center gap-3 cursor-pointer hover:bg-[#f0f2f5] rounded-xl px-4 py-3">
              <div class="w-10 h-10 rounded-full bg-[#d9fdd3] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#00a884]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="text-[#111b21] font-medium">Video</span>
              </div>
              <input type="file" name="attachment" id="attachment-video" class="hidden" accept="video/*" />
            </label>
          </li>
          <li>
            <label class="flex items-center gap-3 cursor-pointer hover:bg-[#f0f2f5] rounded-xl px-4 py-3">
              <div class="w-10 h-10 rounded-full bg-[#d9fdd3] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#00a884]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
