  <input type="radio" name="calendar-day" id="cal-day-28">
  <input type="radio" name="calendar-day" id="cal-day-29">
  <input type="radio" name="calendar-day" id="cal-day-30">

  <label class="ui-day" for="cal-day-1" data-day="1" style="--day: 1"></label>
  <label class="ui-day" for="cal-day-2" data-day="2" style="--day: 2"></label>
  <label class="ui-day" for="cal-day-3" data-day="3" style="--day: 3"></label>
