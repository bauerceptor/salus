  <input type="radio" name="calendar-day" id="cal-day-10">
  <input type="radio" name="calendar-day" id="cal-day-11">
  <input type="radio" name="calendar-day" id="cal-day-12">
  <input type="radio" name="calendar-day" id="cal-day-13">
  <input type="radio" name="calendar-day" id="cal-day-14">
  <input type="radio" name="calendar-day" id="cal-day-15">
  <input type="radio" name="calendar-day" id="cal-day-16">
  <input type="radio" name="calendar-day" id="cal-day-17">
  <input type="radio" name="calendar-day" id="cal-day-18">
  <input type="radio" name="calendar-day" id="cal-day-19">
  <input type="radio" name="calendar-day" id="cal-day-20">
